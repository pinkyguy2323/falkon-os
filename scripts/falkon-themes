#!/usr/bin/env bash
# falkon-themes - движок тем Falkon OS: 25 тем Классики (KDE) + 25 тем Тайлинга (Hyprland)
# База выбирается по текущему оформлению (/etc/falkon-look) или флагом --kde / --hypr.
# Применение одной командой ко всему: терминалы + Waybar + Wofi + GTK + Kvantum + Hyprland
# Использование:
#   falkon-themes list              # 25 тем текущего оформления
#   falkon-themes --kde list        # 25 тем Классики
#   falkon-themes apply "Dracula"   # применить
#   falkon-themes random            # случайная из текущего набора
#   falkon-themes current           # текущая
#   falkon-themes names             # только имена (для falkon-customizer)
set -euo pipefail

LOOK="hypr"
[[ -f /etc/falkon-look ]] && LOOK="$(cat /etc/falkon-look)"
if [[ "${1:-}" == "--kde" ]]; then LOOK="kde"; shift; fi
if [[ "${1:-}" == "--hypr" ]]; then LOOK="hypr"; shift; fi
[[ "$LOOK" != "kde" && "$LOOK" != "hypr" ]] && LOOK="hypr"

find_db() { # $1=kde|hypr -> путь
  local cands=(
    "/usr/share/falkon/themes/$1.conf"
    "$(dirname "$0")/../airootfs/usr/share/falkon/themes/$1.conf"
    "$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/airootfs/usr/share/falkon/themes/$1.conf"
  )
  local p; for p in "${cands[@]}"; do [[ -f "$p" ]] && { echo "$p"; return; }; done
  echo "/usr/share/falkon/themes/$1.conf"
}
DB="$(find_db "$LOOK")"

list() { grep -E '^[0-9]+\|' "$DB" | awk -F'|' '{printf "%-22s  #%s #%s #%s\n", $2, $3, $5, $6}'; }
names() { grep -E '^[0-9]+\|' "$DB" | cut -d'|' -f2; }
current() { cat ~/.config/falkon/current-theme 2>/dev/null || echo "Falkon Swift"; }

get() { # $1=name
  grep -F "|$1|" "$DB" | head -1 || grep -Fi "$1" "$DB" | head -1 || true
}

apply() {
  local name="$1"
  local line; line=$(get "$name")
  # Тема из чужого набора? поищем там и подскажем
  if [[ -z "$line" ]]; then
    local other="hypr"; [[ "$LOOK" == "hypr" ]] && other="kde"
    local od; od="$(find_db "$other")"
    if grep -Fiq "|$name|" "$od" 2>/dev/null; then
      echo "Тема \"$name\" из оформления $other. Смени оформление (sudo falkon-look $other) или выбери из своих 25:"
      LOOK="$other" DB="$od" list; exit 1
    fi
    echo "Тема не найдена: $name"; echo "Доступно:"; list; exit 1
  fi
  IFS='|' read -r _id tname bg fg accent accent2 mode gtk icons <<< "$line"
  echo "[Falkon] Оформление $LOOK, тема: $tname (#$bg #$accent #$accent2 $mode)"
  mkdir -p ~/.config/falkon ~/.config/hypr ~/.config/kitty ~/.config/ghostty ~/.config/waybar ~/.config/wofi ~/.config/gtk-3.0 ~/.config/gtk-4.0 ~/.config/Kvantum

  echo "$tname" > ~/.config/falkon/current-theme
  printf '%s\n%s\n%s\n%s\n%s\n%s\n' "$LOOK" "$bg" "$fg" "$accent" "$accent2" "$mode" > ~/.config/falkon/current-colors

  # --- Hyprland: active border = accent ---
  if [[ -f ~/.config/hypr/hyprland.conf ]]; then
    if grep -q "col.active_border" ~/.config/hypr/hyprland.conf; then
      sed -i "s/col.active_border.*/col.active_border = rgba(${accent}ee) rgba(${accent2}ee) 45deg/" ~/.config/hypr/hyprland.conf
    fi
  fi
  cat > ~/.config/hypr/falkon-theme.conf <<EOF
# Falkon theme: $tname (авто)
general { col.active_border = rgba(${accent}ee) rgba(${accent2}ee) 45deg
  col.inactive_border = rgba(${bg}aa) }
decoration { col.shadow = rgba(${bg}ee) }
EOF

  # --- Kitty ---
  cat > ~/.config/kitty/falkon-theme.conf <<EOF
# $tname
background #$bg
foreground #$fg
color1 #$accent
color2 #$accent2
color3 #$accent
color4 #$accent2
EOF
  grep -q "falkon-theme" ~/.config/kitty/kitty.conf 2>/dev/null || echo "include falkon-theme.conf" >> ~/.config/kitty/kitty.conf 2>/dev/null || true

  # --- Ghostty (главный терминал Falkon) ---
  cat > ~/.config/ghostty/config <<EOF
# Falkon OS Ghostty - тема $tname
background = $bg
foreground = $fg
selection-background = $accent
selection-foreground = $bg
font-family = JetBrainsMono Nerd Font
font-size = 12
background-opacity = 0.95
window-decoration = false
cursor-style = block
EOF

  # --- Waybar ---
  cat > ~/.config/waybar/falkon-colors.css <<EOF
/* Falkon $tname */
@define-color bg #$bg;
@define-color fg #$fg;
@define-color accent #$accent;
@define-color accent2 #$accent2;
EOF

  # --- Wofi ---
  cat > ~/.config/wofi/colors.css <<EOF
@define-color bg #$bg;
@define-color fg #$fg;
@define-color accent #$accent;
EOF

  # --- GTK3/4 (это и красит KDE-приложения) ---
  cat > ~/.config/gtk-3.0/settings.ini <<EOF
[Settings]
gtk-theme-name=$gtk
gtk-icon-theme-name=$icons
gtk-font-name=Inter 10
gtk-cursor-theme-name=Adwaita
EOF
  mkdir -p ~/.config/gtk-4.0
  cp ~/.config/gtk-3.0/settings.ini ~/.config/gtk-4.0/settings.ini
  echo "$gtk" > ~/.config/Kvantum/Current 2>/dev/null || true

  # --- Starship ---
  mkdir -p ~/.config
  if [[ -f ~/.config/starship.toml ]]; then
    sed -i "s/#.*falkon-accent.*/success_symbol = \"[➜](bold #$accent)\" # falkon-accent/" ~/.config/starship.toml || true
  fi

  echo "$tname" | tee ~/.config/falkon/last-theme >/dev/null

  pkill -SIGUSR2 waybar 2>/dev/null || true
  hyprctl reload 2>/dev/null || true
  # KDE подхватит GTK-цвета сразу, плазму целиком красит falkon-look при смене оформления
  echo "[OK] Тема $tname применена ($LOOK, 25 в наборе)"
}

case "${1:-list}" in
  list) list;;
  names) names;;
  current) current;;
  random) apply "$(grep -E '^[0-9]+\|' "$DB" | shuf -n1 | cut -d'|' -f2)";;
  apply) apply "${2:-Falkon Swift}";;
  *) echo "falkon-themes [--kde|--hypr] list|names|apply \"Имя\"|random|current"; exit 1;;
esac
