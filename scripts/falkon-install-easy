#!/usr/bin/env bash
# falkon-install-easy - установщик Falkon OS: как у нормальных людей
#   Система НЕ качается из интернета, а копируется с ISO (как Calamares unpackfs).
#   5-10 минут, почти без трафика. Сеть нужна только для yay и AI-ассистентов в конце.
#   1. Диски человеческим языком, детект Windows/другой ОС, двойное подтверждение wipe
#   2. Разметка EFI + Btrfs, распаковка squashfs с ISO на диск
#   3. Пользователь, загрузчик, оформление (KDE/Hypr/консоль) - всё сразу
set -euo pipefail
LOG=/tmp/falkon-install.log
exec > >(tee -a "$LOG") 2>&1

say() { echo -e "\e[1;34m[Falkon]\e[0m $*"; }
err() { echo -e "\e[1;31m[ОШИБКА]\e[0m $*"; }
need_root() { [[ $EUID -eq 0 ]] || { err "Запусти через sudo"; exit 1; }; }

# Нельзя ставить на носитель, с которого загрузились
live_device() {
  findmnt -n -o SOURCE /run/archiso/bootmnt 2>/dev/null || findmnt -n -o SOURCE / 2>/dev/null || echo ""
}

# Где лежит образ системы на ISO (для офлайн-копирования)
find_sfs() {
  local f
  f=$(find /run/archiso/bootmnt -maxdepth 4 -name 'airootfs.sfs' 2>/dev/null | head -1 || true)
  [[ -n "$f" ]] && { echo "$f"; return; }
  err "Образ системы не найден. Грузись с ISO Falkon OS, а не с установленной системы."
  exit 1
}

list_disks() { # вывод: /dev/sda|500G|Samsung_SSD|описание
  lsblk -d -n -o NAME,SIZE,MODEL,TRAN -e7,11 | while read -r name size model tran; do
    echo "/dev/$name|$size|${model:-диск}|$tran"
  done
}

detect_os_on() { # $1=/dev/sda -> "Windows 11 (/dev/sda1)" или ""
  local disk="$1" out=""
  if command -v os-prober >/dev/null; then
    out=$(os-prober 2>/dev/null | grep "^$disk" || true)
    [[ -n "$out" ]] && { echo "$out" | tr '\n' '; '; return; }
  fi
  for part in $(lsblk -n -o PATH "$disk" 2>/dev/null | tail -n +2); do
    fst=$(lsblk -n -o FSTYPE "$part" 2>/dev/null || true)
    lbl=$(lsblk -n -o LABEL "$part" 2>/dev/null || true)
    [[ "$fst" == "ntfs" ]] && out+="Windows? ($part $lbl); "
    [[ "$fst" =~ ext4|btrfs|xfs ]] && out+="Linux? ($part $lbl); "
  done
  echo "$out"
}

confirm_gui() { # $1=text -> 0=yes
  if command -v yad >/dev/null && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    yad --question --title="Falkon Установка" --text="$1" --width=500; return $?
  else
    echo "$1"; read -rp "[y/N] " a; [[ "$a" =~ ^[YyДд] ]]; return $?
  fi
}

pick_disk_gui() {
  local live; live=$(live_device)
  local rows=""; while IFS= read -r l; do
    dev=$(echo "$l" | cut -d'|' -f1)
    [[ "$live" == "$dev"* ]] && continue  # прячем live-флешку
    found=$(detect_os_on "$dev")
    [[ -z "$found" ]] && found="пустой / данные"
    rows+="$l|$found"$'\n'
  done < <(list_disks)
  [[ -z "$rows" ]] && { err "Диски не найдены"; exit 1; }
  if command -v yad >/dev/null && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    echo "$rows" | yad --list --title="Куда ставить Falkon OS?" --text="Выбери диск (флешка с Live скрыта):" --column="Диск" --column="Размер" --column="Модель" --column="Тип" --column="Что сейчас на диске" --width=750 --height=350 --separator="" | cut -d'|' -f1
  else
    echo "$rows" | tr '|' ' ' | nl
    read -rp "Номер диска: " n
    echo "$rows" | sed -n "${n}p" | cut -d'|' -f1
  fi
}

do_install() { # $1=disk $2=user $3=pass $4=host $5=look $6=lang
  local DISK="$1" USER="$2" PASS="$3" HOST="$4" LOOK="$5" LANGCODE="$6"
  [[ "$LOOK" != "kde" && "$LOOK" != "hypr" && "$LOOK" != "cmd" ]] && LOOK="kde"
  say "Ставлю Falkon OS на $DISK (оформление $LOOK, язык $LANGCODE)..."
  if [[ "$DISK" =~ nvme|mmcblk ]]; then EFI="${DISK}p1"; ROOT="${DISK}p2"; else EFI="${DISK}1"; ROOT="${DISK}2"; fi

  say "[1/7] Разметка (EFI 1G + Btrfs корень)..."
  wipefs -a "$DISK"
  parted -s "$DISK" mklabel gpt mkpart ESP fat32 1MiB 1025MiB set 1 esp on mkpart primary btrfs 1025MiB 100% || { err "Разметка не удалась"; exit 1; }
  partprobe "$DISK"; sleep 2
  mkfs.fat -F32 "$EFI" || { err "mkfs.fat fail"; exit 1; }
  mkfs.btrfs -f "$ROOT" || { err "mkfs.btrfs fail"; exit 1; }
  mount "$ROOT" /mnt || { err "mount fail"; exit 1; }
  mkdir -p /mnt/boot; mount "$EFI" /mnt/boot || { err "mount EFI fail"; exit 1; }

  say "[2/7] Копирую систему с ISO на диск (без интернета, ~5 минут)..."
  SFS=$(find_sfs)
  say "Образ: $SFS"
  command -v unsquashfs >/dev/null || { err "Нет unsquashfs в Live. Перезапиши ISO."; exit 1; }
  unsquashfs -f -d /mnt "$SFS" || { err "Распаковка не удалась (места хватит? надо ~12 ГБ)"; exit 1; }

  say "[3/7] Готовлю систему к первой загрузке..."
  genfstab -U /mnt >> /mnt/etc/fstab
  rm -f /mnt/etc/machine-id
  arch-chroot /mnt systemd-machine-id-setup || true
  rm -rf /mnt/var/lib/pacman/sync/* 2>/dev/null || true  # базы обновятся при первом pacman -Sy

  say "[4/7] Ядро под установленный диск (свой initramfs, без live-крючков)..."
  cat > /mnt/etc/mkinitcpio.conf <<'EOF'
# Falkon OS - сгенерировано установщиком
MODULES=()
BINARIES=()
FILES=()
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
EOF
  mkdir -p /mnt/etc/mkinitcpio.d
  cat > /mnt/etc/mkinitcpio.d/linux.preset <<'EOF'
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux.img"
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
EOF
  arch-chroot /mnt mkinitcpio -P || { err "mkinitcpio fail"; exit 1; }

  say "[5/7] Язык, пользователь, сервисы..."
  arch-chroot /mnt /bin/bash <<EOF
set -e
ln -sf /usr/share/zoneinfo/Europe/Moscow /etc/localtime
hwclock --systohc
for l in ru_RU uk_UA en_US de_DE fr_FR es_ES zh_CN ja_JP pt_BR ar_SA hi_IN tr_TR; do
  echo "\$l.UTF-8 UTF-8" >> /etc/locale.gen
done
locale-gen
echo "LANG=$LANGCODE" > /etc/locale.conf
echo "KEYMAP=us" > /etc/vconsole.conf
echo "$HOST" > /etc/hostname
useradd -m -G wheel,video,audio,storage "$USER"
echo "$USER:$PASS" | chpasswd
echo "root:$PASS" | chpasswd
echo "%wheel ALL=(ALL) ALL" > /etc/sudoers.d/wheel
systemctl enable NetworkManager fstrim.timer
systemctl enable falkon-update-apply.service || true
echo "$LOOK" > /etc/falkon-look
EOF
  # Ключи pacman для установленной системы (интернет не обязателен, но если есть - быстрее)
  arch-chroot /mnt pacman-key --init || true
  arch-chroot /mnt pacman-key --populate archlinux || true

  say "[6/7] Загрузчик..."
  if [[ -d /sys/firmware/efi ]]; then
    arch-chroot /mnt bootctl install
    UUID=$(blkid -s UUID -o value "$ROOT")
    cat > /mnt/boot/loader/entries/falkon.conf <<EOF2
title Falkon OS
linux /vmlinuz-linux
initrd /amd-ucode.img
initrd /intel-ucode.img
initrd /initramfs-linux.img
options root=UUID=$UUID rw quiet splash
EOF2
  else
    arch-chroot /mnt grub-install --target=i386-pc "$DISK"
    arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg
  fi

  say "[7/7] Оформление ($LOOK), драйверы, доп. софт..."
  arch-chroot /mnt falkon-look "$LOOK" || true
  arch-chroot /mnt falkon-drivers --auto || true
  arch-chroot /mnt falkon-tweaks || true
  # yay + AI только если есть интернет, иначе пропускаем (доставишь через welcome)
  if curl -sSL --max-time 10 https://github.com >/dev/null 2>&1; then
    say "Есть интернет: ставлю yay + Claude Code + Codex..."
    arch-chroot /mnt /bin/bash <<EOF3 || say "Доп. софт пропущен, доставишь через falkon-welcome."
set -e
cd /tmp
rm -rf yay-bin
curl -sSL --max-time 60 "https://api.github.com/repos/Jguer/yay/releases/latest" | grep -o '"browser_download_url": *"[^"]*x86_64.tar.gz"' | head -1 | cut -d'"' -f4 | xargs -I{} curl -sSL --max-time 120 {} -o yay.tar.gz
tar xzf yay.tar.gz
install -m755 yay /usr/local/bin/yay
npm i -g @anthropic-ai/claude-code @openai/codex || true
EOF3
  else
    say "Интернета нет - пропускаю yay и AI (потом: falkon-welcome)."
  fi

  umount -R /mnt
  say "ГОТОВО. Вытащи флешку и перезагрузись. Логин: $USER. Лог: $LOG"
}

main() {
  need_root
  DISK=$(pick_disk_gui)
  [[ -z "$DISK" ]] && { err "Диск не выбран"; exit 1; }
  say "Выбран: $DISK"
  FOUND=$(detect_os_on "$DISK")
  if [[ -n "$FOUND" ]]; then
    say "На $DISK замечено: $FOUND"
    if ! confirm_gui "На диске $DISK найдено:\n$FOUND\n\n<b>Очистить ВЕСЬ диск и поставить Falkon OS?</b>\nВсё на нём будет удалено!"; then
      say "Отмена. Выбери другой диск."; exit 0
    fi
    if ! confirm_gui "Точно-точно стереть <b>$DISK</b>? Это последнее предупреждение."; then
      say "Отмена."; exit 0
    fi
  else
    confirm_gui "Ставить Falkon OS на <b>$DISK</b>?\nСистема скопируется с ISO, диск будет очищен." || exit 0
  fi
  # Данные пользователя + оформление (ОДНА система, три лица)
  if command -v yad >/dev/null && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    vals=$(yad --form --title="Falkon OS - установка" --text="Придумай пользователя + выбери оформление:" --field="Имя пользователя" "falkon" --field="Имя ПК" "falkon-pc" --field="Оформление:CB" "Классика (KDE)!Тайлинг (Hyprland)!Консоль (без графики)" --field="Язык:CB" "ru_RU.UTF-8!uk_UA.UTF-8!en_US.UTF-8!zh_CN.UTF-8!ja_JP.UTF-8!es_ES.UTF-8!fr_FR.UTF-8!de_DE.UTF-8" --field="Пароль:H" "")
    [[ -z "$vals" ]] && exit 0
    IFS='|' read -r USER HOST LOOKNAME LANGCODE PASS <<< "$vals"
    case "$LOOKNAME" in "Тайлинг"*) LOOK="hypr";; "Консоль"*) LOOK="cmd";; *) LOOK="kde";; esac
  else
    read -rp "Пользователь [falkon]: " USER; USER=${USER:-falkon}
    read -rp "Имя ПК [falkon-pc]: " HOST; HOST=${HOST:-falkon-pc}
    read -rp "Оформление kde/hypr/cmd [kde]: " LOOK; LOOK=${LOOK:-kde}
    read -rp "Локаль [ru_RU.UTF-8]: " LANGCODE; LANGCODE=${LANGCODE:-ru_RU.UTF-8}
    read -rsp "Пароль: " PASS; echo
    [[ -z "$PASS" ]] && { err "Пустой пароль нельзя"; exit 1; }
  fi
  do_install "$DISK" "$USER" "$PASS" "$HOST" "$LOOK" "$LANGCODE"
  command -v yad >/dev/null && yad --info --text="Готово! Вытащи флешку и перезагрузись." --timeout=5 || true
}

main
